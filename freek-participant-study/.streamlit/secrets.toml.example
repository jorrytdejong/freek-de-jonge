# Copy this file to secrets.toml for local development only.
# Configure the same key in Streamlit Community Cloud for deployment.
admin_password = "replace-with-a-long-unique-password"
storage_backend = "google_sheets"

# Checkpoint 11 keeps real payments locked by default. For a reviewed production
# launch, use a separate production ledger and set all three values deliberately:
# reward_mode = "tremendous_production"
# deployment_environment = "production"
# real_rewards_ack = "I_UNDERSTAND_THIS_SENDS_REAL_MONEY"
# reward_ledger_path = "data/runtime/rewards.production.csv"
# reward_max_issued = 1
# reward_budget_eur = "3.40"
# production_canary_enabled = true
# production_canary_reward_reference = "reward-replace-with-24-hex-characters"
# [tremendous]
# api_key = "PROD_replace-me"
# campaign_id = "replace-me"
# funding_source_id = "replace-me"

# Paste the complete private registry generated by
# scripts/generate_production_sessions.py between the triple quotes.
sessions_csv = '''
session_id,is_test,active,assignment_groups,created_at,notes
'''

[google_sheets]
spreadsheet_url = "https://docs.google.com/spreadsheets/d/replace-me/edit"
worksheet = "progress"

[google_sheets.credentials]
type = "service_account"
project_id = "replace-me"
private_key_id = "replace-me"
private_key = "-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
client_email = "replace-me@replace-me.iam.gserviceaccount.com"
client_id = "replace-me"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "replace-me"
