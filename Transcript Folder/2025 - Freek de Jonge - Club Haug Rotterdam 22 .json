{
  "lines" : [
    {
      "endTime" : "00:00:05,000",
      "speakerDesignation" : "",
      "startTime" : "00:00:00,001",
      "text" : "Sinterklaas"
    },
    {
      "endTime" : "00:00:33,400",
      "speakerDesignation" : "",
      "startTime" : "00:00:30,000",
      "text" : "Mijn vrienden zijn vrij, mijn schalen meer."
    },
    {
      "endTime" : "00:00:39,840",
      "speakerDesignation" : "",
      "startTime" : "00:00:33,560",
      "text" : "Mijn ouders werden radeloos, willen we een keer nog meer."
    },
    {
      "endTime" : "00:00:42,000",
      "speakerDesignation" : "",
      "startTime" : "00:00:40,000",
      "text" : "Amen."
    },
    {
      "endTime" : "00:00:44,960",
      "speakerDesignation" : "",
      "startTime" : "00:00:42,160",
      "text" : "Welkom bij Comedy Club Houw."
    },
    {
      "endTime" : "00:00:49,280",
      "speakerDesignation" : "",
      "startTime" : "00:00:45,120",
      "text" : "Mag ik een katerpout voor de enige en gepreet de jongen?"
    },
    {
      "endTime" : "00:00:53,400",
      "speakerDesignation" : "",
      "startTime" : "00:00:49,440",
      "text" : "Zijn er tot zover vragen, dames en heren?"
    },
    {
      "endTime" : "00:00:55,560",
      "speakerDesignation" : "",
      "startTime" : "00:00:53,560",
      "text" : "GELACH"
    },
    {
      "endTime" : "00:00:59,360",
      "speakerDesignation" : "",
      "startTime" : "00:00:55,560",
      "text" : "Zijn er tot zover vragen?"
    },
    {
      "endTime" : "00:01:04,320",
      "speakerDesignation" : "",
      "startTime" : "00:01:02,360",
      "text" : "Sinterklaas was jarig."
    },
    {
      "endTime" : "00:01:08,420",
      "speakerDesignation" : "",
      "startTime" : "00:01:06,060",
      "text" : "Ik kreeg een hele hoop cadeaus."
    },
    {
      "endTime" : "00:01:16,880",
      "speakerDesignation" : "",
      "startTime" : "00:01:10,760",
      "text" : "Tenmidden van het pak papier was ik ontzettend boos."
    },
    {
      "endTime" : "00:01:19,620",
      "speakerDesignation" : "",
      "startTime" : "00:01:18,020",
      "text" : "Een chocoladeletter."
    },
    {
      "endTime" : "00:01:23,880",
      "speakerDesignation" : "",
      "startTime" : "00:01:20,840",
      "text" : "Een bal, een tol, een beer."
    },
    {
      "endTime" : "00:01:28,300",
      "speakerDesignation" : "",
      "startTime" : "00:01:23,880",
      "text" : "Mijn ouders waren vanhopig"
    },
    {
      "endTime" : "00:01:32,200",
      "speakerDesignation" : "",
      "startTime" : "00:01:28,300",
      "text" : "Wat wil dat kind?"
    },
    {
      "endTime" : "00:01:38,240",
      "speakerDesignation" : "",
      "startTime" : "00:01:36,200",
      "text" : "We hebben dichters in de zaal"
    },
    {
      "endTime" : "00:01:42,620",
      "speakerDesignation" : "",
      "startTime" : "00:01:38,240",
      "text" : "Wat wil dat kind nog meer?"
    },
    {
      "endTime" : "00:01:47,620",
      "speakerDesignation" : "",
      "startTime" : "00:01:46,620",
      "text" : "Aandacht"
    },
    {
      "endTime" : "00:01:53,620",
      "speakerDesignation" : "",
      "startTime" : "00:01:48,180",
      "text" : "Aandacht"
    },
    {
      "endTime" : "00:02:00,260",
      "speakerDesignation" : "",
      "startTime" : "00:01:53,620",
      "text" : "Van aandacht krijgt niemand ooit genoeg."
    },
    {
      "endTime" : "00:02:04,500",
      "speakerDesignation" : "",
      "startTime" : "00:02:02,000",
      "text" : "Aandacht."
    },
    {
      "endTime" : "00:02:08,000",
      "speakerDesignation" : "",
      "startTime" : "00:02:06,480",
      "text" : "Aandacht."
    },
    {
      "endTime" : "00:02:14,620",
      "speakerDesignation" : "",
      "startTime" : "00:02:09,620",
      "text" : "Van aandacht krijgt niemand ooit..."
    },
    {
      "endTime" : "00:02:15,620",
      "speakerDesignation" : "",
      "startTime" : "00:02:14,620",
      "text" : "genoeg."
    },
    {
      "endTime" : "00:02:27,400",
      "speakerDesignation" : "",
      "startTime" : "00:02:15,620",
      "text" : "De een trekt hier en daar lacherig aandacht."
    },
    {
      "endTime" : "00:02:37,400",
      "speakerDesignation" : "",
      "startTime" : "00:02:31,260",
      "text" : "De ander doet het ergens rauwig."
    },
    {
      "endTime" : "00:02:45,520",
      "speakerDesignation" : "",
      "startTime" : "00:02:38,640",
      "text" : "Ik doe het al jaren op de planken van het nieuwe Luxor."
    },
    {
      "endTime" : "00:02:49,420",
      "speakerDesignation" : "",
      "startTime" : "00:02:45,620",
      "text" : "tot aan Club Haug."
    },
    {
      "endTime" : "00:02:54,200",
      "speakerDesignation" : "",
      "startTime" : "00:02:50,740",
      "text" : "Hele weekend na zitten denken, waar kan ik Haug op laten rijden?"
    },
    {
      "endTime" : "00:02:57,780",
      "speakerDesignation" : "",
      "startTime" : "00:02:55,080",
      "text" : "Ik zag nu al een heel groot gedeelte van het publiek"
    },
    {
      "endTime" : "00:03:00,840",
      "speakerDesignation" : "",
      "startTime" : "00:02:57,780",
      "text" : "de hele tijd naar dat bord Club Haug zitten kijken."
    },
    {
      "endTime" : "00:03:06,360",
      "speakerDesignation" : "",
      "startTime" : "00:03:01,580",
      "text" : "De een die weet niet hoe het te trekken."
    },
    {
      "endTime" : "00:03:11,580",
      "speakerDesignation" : "",
      "startTime" : "00:03:07,740",
      "text" : "De ander gaat ervoor op les."
    },
    {
      "endTime" : "00:03:18,420",
      "speakerDesignation" : "",
      "startTime" : "00:03:11,580",
      "text" : "Ik sta al jaren op de planken van KD tot aan de KS."
    },
    {
      "endTime" : "00:03:24,240",
      "speakerDesignation" : "",
      "startTime" : "00:03:21,220",
      "text" : "Het is uniek, hè. Alleen als ik hier sta is het zo."
    },
    {
      "endTime" : "00:03:30,140",
      "speakerDesignation" : "",
      "startTime" : "00:03:24,680",
      "text" : "Laten we beginnen, dames en heren, met de actualiteit."
    },
    {
      "endTime" : "00:03:37,580",
      "speakerDesignation" : "",
      "startTime" : "00:03:31,300",
      "text" : "En wat mij is opgevallen is dat eigenlijk de actualiteit..."
    },
    {
      "endTime" : "00:03:43,640",
      "speakerDesignation" : "",
      "startTime" : "00:03:37,580",
      "text" : "op dit moment eigenlijk nog nooit zo actueel geweest is als nu."
    },
    {
      "endTime" : "00:03:47,540",
      "speakerDesignation" : "",
      "startTime" : "00:03:44,900",
      "text" : "Ik weet niet hoe u dat zelf..."
    },
    {
      "endTime" : "00:03:50,560",
      "speakerDesignation" : "",
      "startTime" : "00:03:47,540",
      "text" : "En het gaat razendsnel."
    },
    {
      "endTime" : "00:03:52,720",
      "speakerDesignation" : "",
      "startTime" : "00:03:50,720",
      "text" : "Ik heb hier bijvoorbeeld staan Omtzigt."
    },
    {
      "endTime" : "00:03:56,660",
      "speakerDesignation" : "",
      "startTime" : "00:03:54,040",
      "text" : "Nou, zie je wat? Het is alweer weg. Het is alweer weg!"
    },
    {
      "endTime" : "00:04:01,920",
      "speakerDesignation" : "",
      "startTime" : "00:03:58,040",
      "text" : "Dat was een paar... Gisteren was het... Mensen stonden op de banken."
    },
    {
      "endTime" : "00:04:04,240",
      "speakerDesignation" : "",
      "startTime" : "00:04:02,160",
      "text" : "Maar bij Omtzigt zit er een sentiment."
    },
    {
      "endTime" : "00:04:06,440",
      "speakerDesignation" : "",
      "startTime" : "00:04:04,240",
      "text" : "Ik weet niet of dat ook bij u zo is."
    },
    {
      "endTime" : "00:04:08,440",
      "speakerDesignation" : "",
      "startTime" : "00:04:06,440",
      "text" : "Dan zit er een sentiment van..."
    },
    {
      "endTime" : "00:04:11,440",
      "speakerDesignation" : "",
      "startTime" : "00:04:08,440",
      "text" : "Godver de Godver."
    },
    {
      "endTime" : "00:04:15,440",
      "speakerDesignation" : "",
      "startTime" : "00:04:12,700",
      "text" : "Die man heeft ervoor gezorgd dat wij met dit kabinet..."
    },
    {
      "endTime" : "00:04:19,440",
      "speakerDesignation" : "",
      "startTime" : "00:04:16,000",
      "text" : "en met Wilders en met die hele midbakzinnen opgeschreven..."
    },
    {
      "endTime" : "00:04:21,440",
      "speakerDesignation" : "",
      "startTime" : "00:04:20,380",
      "text" : "Dit is werkelijk..."
    },
    {
      "endTime" : "00:04:25,680",
      "speakerDesignation" : "",
      "startTime" : "00:04:22,060",
      "text" : "Het is werkelijk een godgeklaagd..."
    },
    {
      "endTime" : "00:04:28,660",
      "speakerDesignation" : "",
      "startTime" : "00:04:25,680",
      "text" : "En het kan maar op één manier goed gemaakt worden..."
    },
    {
      "endTime" : "00:04:30,400",
      "speakerDesignation" : "",
      "startTime" : "00:04:28,660",
      "text" : "als Twente van PSV wint."
    },
    {
      "endTime" : "00:04:35,960",
      "speakerDesignation" : "",
      "startTime" : "00:04:32,280",
      "text" : "Laten we even naar teletext gaan..."
    },
    {
      "endTime" : "00:04:37,680",
      "speakerDesignation" : "",
      "startTime" : "00:04:35,960",
      "text" : "zoals het er op dit moment voor staat."
    },
    {
      "endTime" : "00:04:39,720",
      "speakerDesignation" : "",
      "startTime" : "00:04:38,420",
      "text" : "Dat begint met..."
    },
    {
      "endTime" : "00:04:42,320",
      "speakerDesignation" : "",
      "startTime" : "00:04:39,720",
      "text" : "Trump haalt hard uit naar Zelensky."
    },
    {
      "endTime" : "00:04:44,920",
      "speakerDesignation" : "",
      "startTime" : "00:04:42,420",
      "text" : "Ja, je zal zo'n onderhandelaar hebben..."
    },
    {
      "endTime" : "00:04:47,160",
      "speakerDesignation" : "",
      "startTime" : "00:04:44,920",
      "text" : "die gereeds van de steek van de vorige droepen..."
    },
    {
      "endTime" : "00:04:48,700",
      "speakerDesignation" : "",
      "startTime" : "00:04:47,160",
      "text" : "en je moet de krim inleveren..."
    },
    {
      "endTime" : "00:04:51,400",
      "speakerDesignation" : "",
      "startTime" : "00:04:48,700",
      "text" : "en je moet al je bezette gebieden, die zijn voor Rusland..."
    },
    {
      "endTime" : "00:04:52,940",
      "speakerDesignation" : "",
      "startTime" : "00:04:51,400",
      "text" : "en dan gaan we daarna onderhandelen."
    },
    {
      "endTime" : "00:04:55,060",
      "speakerDesignation" : "",
      "startTime" : "00:04:53,400",
      "text" : "Het is echt een renner, zegt Zelensky."
    },
    {
      "endTime" : "00:04:58,000",
      "speakerDesignation" : "",
      "startTime" : "00:04:55,140",
      "text" : "Ja, maar wacht even. Zij hebben het van ons afgepakt."
    },
    {
      "endTime" : "00:05:00,180",
      "speakerDesignation" : "",
      "startTime" : "00:04:58,420",
      "text" : "En wij... Hou je grote bek!"
    },
    {
      "endTime" : "00:05:02,880",
      "speakerDesignation" : "",
      "startTime" : "00:05:00,520",
      "text" : "Wij bepalen hier als dit. Wij zijn dit."
    },
    {
      "endTime" : "00:05:05,760",
      "speakerDesignation" : "",
      "startTime" : "00:05:02,880",
      "text" : "Ik heb een nieuwssoort diplomatie."
    },
    {
      "endTime" : "00:05:08,700",
      "speakerDesignation" : "",
      "startTime" : "00:05:05,940",
      "text" : "We reden vanmiddag nog langs een cd-autootje."
    },
    {
      "endTime" : "00:05:10,500",
      "speakerDesignation" : "",
      "startTime" : "00:05:08,820",
      "text" : "Met cd, zo'n nummer wordt cd."
    },
    {
      "endTime" : "00:05:13,460",
      "speakerDesignation" : "",
      "startTime" : "00:05:11,000",
      "text" : "En daar zat zo'n diplomaat achterin."
    },
    {
      "endTime" : "00:05:14,980",
      "speakerDesignation" : "",
      "startTime" : "00:05:13,820",
      "text" : "Het was toevallig een Tesla."
    },
    {
      "endTime" : "00:05:18,060",
      "speakerDesignation" : "",
      "startTime" : "00:05:15,220",
      "text" : "Ik weet niet hoe dat zo kan."
    },
    {
      "endTime" : "00:05:21,560",
      "speakerDesignation" : "",
      "startTime" : "00:05:18,560",
      "text" : "En die tijd is wel voorgoed voor mij."
    },
    {
      "endTime" : "00:05:24,220",
      "speakerDesignation" : "",
      "startTime" : "00:05:22,360",
      "text" : "Verkrachter Nijmegen moet de cel in."
    },
    {
      "endTime" : "00:05:25,140",
      "speakerDesignation" : "",
      "startTime" : "00:05:24,300",
      "text" : "Slaan we ook over."
    },
    {
      "endTime" : "00:05:27,660",
      "speakerDesignation" : "",
      "startTime" : "00:05:25,680",
      "text" : "18 jaar cel voor moorden naar Capelle."
    },
    {
      "endTime" : "00:05:30,520",
      "speakerDesignation" : "",
      "startTime" : "00:05:27,960",
      "text" : "AI kan longkanker eerder opsporen."
    },
    {
      "endTime" : "00:05:32,440",
      "speakerDesignation" : "",
      "startTime" : "00:05:30,520",
      "text" : "Dat is een fijn bericht natuurlijk."
    },
    {
      "endTime" : "00:05:34,760",
      "speakerDesignation" : "",
      "startTime" : "00:05:32,440",
      "text" : "dat we dat nog even mee kunnen nemen."
    },
    {
      "endTime" : "00:05:38,440",
      "speakerDesignation" : "",
      "startTime" : "00:05:35,260",
      "text" : "En dan gaan we naar meer gaswinning op de Noordzee."
    },
    {
      "endTime" : "00:05:43,440",
      "speakerDesignation" : "",
      "startTime" : "00:05:39,480",
      "text" : "Want als er één leidt onder de huidige actualiteit..."
    },
    {
      "endTime" : "00:05:46,280",
      "speakerDesignation" : "",
      "startTime" : "00:05:44,700",
      "text" : "dan is het het milieu wel."
    },
    {
      "endTime" : "00:05:51,440",
      "speakerDesignation" : "",
      "startTime" : "00:05:46,400",
      "text" : "Dat herinnert mij er meteen even aan dat ik even het decor van vanavond..."
    },
    {
      "endTime" : "00:05:53,400",
      "speakerDesignation" : "",
      "startTime" : "00:05:52,580",
      "text" : "Ho, ach."
    },
    {
      "endTime" : "00:05:55,680",
      "speakerDesignation" : "",
      "startTime" : "00:05:54,420",
      "text" : "Nou, nou, ach."
    },
    {
      "endTime" : "00:06:00,740",
      "speakerDesignation" : "",
      "startTime" : "00:05:56,980",
      "text" : "Nou ja, het is wel kenmerkend voor de staat van..."
    },
    {
      "endTime" : "00:06:06,380",
      "speakerDesignation" : "",
      "startTime" : "00:06:00,740",
      "text" : "Ah, ah, misschien heb ik nog een reserve."
    },
    {
      "endTime" : "00:06:14,060",
      "speakerDesignation" : "",
      "startTime" : "00:06:10,380",
      "text" : "Kijk, dat gaat even om de bedreiging van de natuur."
    },
    {
      "endTime" : "00:06:19,040",
      "speakerDesignation" : "",
      "startTime" : "00:06:14,820",
      "text" : "En dan had ik dat dit, zeg maar als symbolisch, je moet het allemaal symbolisch zien enzo."
    },
    {
      "endTime" : "00:06:20,440",
      "speakerDesignation" : "",
      "startTime" : "00:06:19,360",
      "text" : "En dan had ik dit bij verzonnen."
    },
    {
      "endTime" : "00:06:28,260",
      "speakerDesignation" : "",
      "startTime" : "00:06:27,080",
      "text" : "Vanwege de droogte."
    },
    {
      "endTime" : "00:06:33,120",
      "speakerDesignation" : "",
      "startTime" : "00:06:28,260",
      "text" : "Twee avonden hebben we geprobeerd dat ik dan zo'n slok benzine nam."
    },
    {
      "endTime" : "00:06:34,500",
      "speakerDesignation" : "",
      "startTime" : "00:06:33,300",
      "text" : "En dan..."
    },
    {
      "endTime" : "00:06:35,640",
      "speakerDesignation" : "",
      "startTime" : "00:06:34,500",
      "text" : "Maar dat was gevaarlijk."
    },
    {
      "endTime" : "00:06:37,880",
      "speakerDesignation" : "",
      "startTime" : "00:06:35,760",
      "text" : "Dat heeft de brandweer verboden."
    },
    {
      "endTime" : "00:06:42,880",
      "speakerDesignation" : "",
      "startTime" : "00:06:37,880",
      "text" : "Dus doen we het even op deze manier."
    },
    {
      "endTime" : "00:06:53,120",
      "speakerDesignation" : "",
      "startTime" : "00:06:49,720",
      "text" : "Tot zover het milieu, dames en heren."
    },
    {
      "endTime" : "00:07:01,240",
      "speakerDesignation" : "",
      "startTime" : "00:06:53,120",
      "text" : "Ja, teletext was, moet ik u eerlijk zeggen, gisteren aanzienlijk leuker."
    },
    {
      "endTime" : "00:07:04,600",
      "speakerDesignation" : "",
      "startTime" : "00:07:01,300",
      "text" : "Er was een wolf aangereden in Drenthe. Een wolf."
    },
    {
      "endTime" : "00:07:08,260",
      "speakerDesignation" : "",
      "startTime" : "00:07:05,400",
      "text" : "Wolf dood na aanrijving in Drenthe."
    },
    {
      "endTime" : "00:07:15,500",
      "speakerDesignation" : "",
      "startTime" : "00:07:09,500",
      "text" : "Een automobilist heeft op de A28 bij Tienaarlo een wolf aangereden."
    },
    {
      "endTime" : "00:07:18,780",
      "speakerDesignation" : "",
      "startTime" : "00:07:16,360",
      "text" : "Het dier, een mannetje."
    },
    {
      "endTime" : "00:07:22,720",
      "speakerDesignation" : "",
      "startTime" : "00:07:18,780",
      "text" : "Ik vind dat zo ongelooflijk denigrerend."
    },
    {
      "endTime" : "00:07:25,900",
      "speakerDesignation" : "",
      "startTime" : "00:07:23,420",
      "text" : "Het is godverdorie een wolf zeg."
    },
    {
      "endTime" : "00:07:28,100",
      "speakerDesignation" : "",
      "startTime" : "00:07:26,480",
      "text" : "Ach een mannetje weet je wel."
    },
    {
      "endTime" : "00:07:29,940",
      "speakerDesignation" : "",
      "startTime" : "00:07:29,080",
      "text" : "Een mannetje."
    },
    {
      "endTime" : "00:07:32,500",
      "speakerDesignation" : "",
      "startTime" : "00:07:30,560",
      "text" : "Bleek zo zwaar gewond."
    },
    {
      "endTime" : "00:07:36,820",
      "speakerDesignation" : "",
      "startTime" : "00:07:32,980",
      "text" : "Dat een dierenarts besloot hem een spuitje te geven."
    },
    {
      "endTime" : "00:07:42,560",
      "speakerDesignation" : "",
      "startTime" : "00:07:38,860",
      "text" : "De automobilist is ongedeerd."
    },
    {
      "endTime" : "00:07:46,480",
      "speakerDesignation" : "",
      "startTime" : "00:07:43,520",
      "text" : "Maar desondanks besloot de dierenarts."
    },
    {
      "endTime" : "00:07:51,480",
      "speakerDesignation" : "",
      "startTime" : "00:07:48,780",
      "text" : "Hem ook een spuitje te geven."
    },
    {
      "endTime" : "00:07:59,480",
      "speakerDesignation" : "",
      "startTime" : "00:07:55,780",
      "text" : "De auto en de bestuurder moesten worden weggesleept."
    },
    {
      "endTime" : "00:08:07,400",
      "speakerDesignation" : "",
      "startTime" : "00:08:03,360",
      "text" : "Sinds enkele jaren zijn er wolven in Drenthe."
    },
    {
      "endTime" : "00:08:12,180",
      "speakerDesignation" : "",
      "startTime" : "00:08:08,500",
      "text" : "Sinds enkele jaren zijn er wolven in Drenthe."
    },
    {
      "endTime" : "00:08:19,780",
      "speakerDesignation" : "",
      "startTime" : "00:08:12,180",
      "text" : "En er staat eronder, in 2022 kreeg een wolvenpaar in het grensgebied met Friesland welpen."
    },
    {
      "endTime" : "00:08:23,380",
      "speakerDesignation" : "",
      "startTime" : "00:08:21,560",
      "text" : "Een leuk einde van dat bericht."
    },
    {
      "endTime" : "00:08:29,020",
      "speakerDesignation" : "",
      "startTime" : "00:08:26,620",
      "text" : "Wie? Er zitten mensen op de redactie."
    },
    {
      "endTime" : "00:08:32,820",
      "speakerDesignation" : "",
      "startTime" : "00:08:30,580",
      "text" : "En die denken, oh, we gooien die welpen er nog in."
    },
    {
      "endTime" : "00:08:38,420",
      "speakerDesignation" : "",
      "startTime" : "00:08:34,640",
      "text" : "Het is van een volstrekte willekeur. Wat moeten we met dit bericht?"
    },
    {
      "endTime" : "00:08:42,020",
      "speakerDesignation" : "",
      "startTime" : "00:08:38,420",
      "text" : "Nieuws. Gaan we verder."
    },
    {
      "endTime" : "00:08:46,880",
      "speakerDesignation" : "",
      "startTime" : "00:08:42,980",
      "text" : "14 arrestaties voor opruiming TikTok."
    },
    {
      "endTime" : "00:08:52,600",
      "speakerDesignation" : "",
      "startTime" : "00:08:49,300",
      "text" : "De politie heeft 14 mensen opgepakt."
    },
    {
      "endTime" : "00:09:01,180",
      "speakerDesignation" : "",
      "startTime" : "00:08:53,060",
      "text" : "Ze zouden onder meer op TikTok hebben geprobeerd mensen aan te sporen tot het plegen van terroristische misdrijven."
    },
    {
      "endTime" : "00:09:03,940",
      "speakerDesignation" : "",
      "startTime" : "00:09:02,140",
      "text" : "Ik weet niet of u kleinkinderen heeft, ik heb ze."
    },
    {
      "endTime" : "00:09:05,660",
      "speakerDesignation" : "",
      "startTime" : "00:09:04,260",
      "text" : "En die zitten op TikTok."
    },
    {
      "endTime" : "00:09:11,100",
      "speakerDesignation" : "",
      "startTime" : "00:09:05,660",
      "text" : "En dan komen ze mij open op bezoek en dan zeg ik, en nog oproepen tot terroristisch."
    },
    {
      "endTime" : "00:09:21,560",
      "speakerDesignation" : "",
      "startTime" : "00:09:17,400",
      "text" : "De verdachten zijn tussen de 14 en de 30 jaar."
    },
    {
      "endTime" : "00:09:26,660",
      "speakerDesignation" : "",
      "startTime" : "00:09:22,440",
      "text" : "Acht van hen werden aangehouden door de eenheid landelijke opsporing en interventies."
    },
    {
      "endTime" : "00:09:32,960",
      "speakerDesignation" : "",
      "startTime" : "00:09:27,540",
      "text" : "En de andere zes werden door politieeenheden Den Haag, Rotterdam en Amsterdam aangehouden."
    },
    {
      "endTime" : "00:09:37,380",
      "speakerDesignation" : "",
      "startTime" : "00:09:32,960",
      "text" : "Dat is even om ons te laten weten dat ze daar niet uit hun neus zitten te vreten."
    },
    {
      "endTime" : "00:09:45,360",
      "speakerDesignation" : "",
      "startTime" : "00:09:38,500",
      "text" : "Of de 14 elkaar kenden, kan het OM nog niet zeggen, zolang het onderzoek loopt."
    },
    {
      "endTime" : "00:09:51,560",
      "speakerDesignation" : "",
      "startTime" : "00:09:46,620",
      "text" : "Mogelijk reageerden ze op elkaars posts."
    },
    {
      "endTime" : "00:09:54,760",
      "speakerDesignation" : "",
      "startTime" : "00:09:52,300",
      "text" : "Het is niet op voorlezen geschreven deze ding."
    },
    {
      "endTime" : "00:09:57,780",
      "speakerDesignation" : "",
      "startTime" : "00:09:55,560",
      "text" : "Want elkaars posts."
    },
    {
      "endTime" : "00:10:02,700",
      "speakerDesignation" : "",
      "startTime" : "00:09:59,020",
      "text" : "Dat zal er bij een hoop mensen van mijn leeftijd heel moeilijk uitkomen."
    },
    {
      "endTime" : "00:10:11,600",
      "speakerDesignation" : "",
      "startTime" : "00:10:02,960",
      "text" : "Ja, dan kunnen de boventanden er zo uitschieten."
    },
    {
      "endTime" : "00:10:25,040",
      "speakerDesignation" : "",
      "startTime" : "00:10:16,600",
      "text" : "En dan staat er ook niet, is bekendgemaakt of ze een bepaalde ideologie aanhingen."
    },
    {
      "endTime" : "00:10:30,040",
      "speakerDesignation" : "",
      "startTime" : "00:10:26,320",
      "text" : "En dan voeg ik eraan toe, maar het vermoeden bestaat..."
    },
    {
      "endTime" : "00:10:34,660",
      "speakerDesignation" : "",
      "startTime" : "00:10:30,040",
      "text" : "dat ze best wel eens fans van Roxy Dekker zouden kunnen zijn."
    },
    {
      "endTime" : "00:10:40,380",
      "speakerDesignation" : "",
      "startTime" : "00:10:38,440",
      "text" : "En dan hadden we verder..."
    },
    {
      "endTime" : "00:10:42,400",
      "speakerDesignation" : "",
      "startTime" : "00:10:40,380",
      "text" : "is het natuurlijk de pauze is overleden."
    },
    {
      "endTime" : "00:10:44,560",
      "speakerDesignation" : "",
      "startTime" : "00:10:42,500",
      "text" : "Ja, Schoof en Veldkamp gaan erin."
    },
    {
      "endTime" : "00:10:47,400",
      "speakerDesignation" : "",
      "startTime" : "00:10:44,860",
      "text" : "De koning die moet tezelfde tijd..."
    },
    {
      "endTime" : "00:10:49,820",
      "speakerDesignation" : "",
      "startTime" : "00:10:47,400",
      "text" : "Dat is ook ongelooflijk toevallig."
    },
    {
      "endTime" : "00:10:52,080",
      "speakerDesignation" : "",
      "startTime" : "00:10:49,960",
      "text" : "Dat kan je allemaal niet bedenken. Ja, God natuurlijk."
    },
    {
      "endTime" : "00:10:55,460",
      "speakerDesignation" : "",
      "startTime" : "00:10:52,460",
      "text" : "Maar dat je op tweede paasdag overlijdt..."
    },
    {
      "endTime" : "00:10:57,620",
      "speakerDesignation" : "",
      "startTime" : "00:10:55,460",
      "text" : "waardoor, zeg maar, Koningsdag..."
    },
    {
      "endTime" : "00:11:02,280",
      "speakerDesignation" : "",
      "startTime" : "00:10:57,620",
      "text" : "eigenlijk, zeg maar, ontzondig was, dat die een dag naar voren schuift,"
    },
    {
      "endTime" : "00:11:06,460",
      "speakerDesignation" : "",
      "startTime" : "00:11:02,280",
      "text" : "waardoor de begrafenis van de paus samenvalt met Koningsdag."
    },
    {
      "endTime" : "00:11:10,700",
      "speakerDesignation" : "",
      "startTime" : "00:11:06,460",
      "text" : "Ongelooflijk hoe dat in mekaar zit daar boven, wat ze allemaal,"
    },
    {
      "endTime" : "00:11:14,360",
      "speakerDesignation" : "",
      "startTime" : "00:11:10,700",
      "text" : "en dat de koning er dan niet heen gaat, want ja, het is Doetinchem."
    },
    {
      "endTime" : "00:11:19,520",
      "speakerDesignation" : "",
      "startTime" : "00:11:14,360",
      "text" : "En ze kunnen echt niet zeggen, dat is de Achterhoek, ze kunnen echt niet zeggen,"
    },
    {
      "endTime" : "00:11:21,860",
      "speakerDesignation" : "",
      "startTime" : "00:11:19,520",
      "text" : "ja, we moeten naar de paus. Ja, daar heb je het weer hoor."
    },
    {
      "endTime" : "00:11:24,680",
      "speakerDesignation" : "",
      "startTime" : "00:11:21,860",
      "text" : "Ze hebben een kut smoes om niet, dat doet u geen doven."
    },
    {
      "endTime" : "00:11:34,680",
      "speakerDesignation" : "",
      "startTime" : "00:11:24,680",
      "text" : "Dus ja, die koning moet daar nu in Doetinchem terwijl Schoven Velk kan met zo'n gezicht bij die..."
    },
    {
      "endTime" : "00:11:39,540",
      "speakerDesignation" : "",
      "startTime" : "00:11:34,680",
      "text" : "Terwijl het nog afwachten is, want ja, je weet de paus is overleden op tweede paasdag."
    },
    {
      "endTime" : "00:11:44,540",
      "speakerDesignation" : "",
      "startTime" : "00:11:40,120",
      "text" : "Die kan ook misschien op donderdag, dat die opeens zou..."
    },
    {
      "endTime" : "00:11:49,320",
      "speakerDesignation" : "",
      "startTime" : "00:11:44,540",
      "text" : "Wat de hek is dat hier zeg?"
    },
    {
      "endTime" : "00:11:52,140",
      "speakerDesignation" : "",
      "startTime" : "00:11:50,600",
      "text" : "Weet je, wat ik bedoel?"
    },
    {
      "endTime" : "00:11:56,980",
      "speakerDesignation" : "",
      "startTime" : "00:11:54,680",
      "text" : "Goed. Mevrouw Faber."
    },
    {
      "endTime" : "00:12:00,700",
      "speakerDesignation" : "",
      "startTime" : "00:11:58,640",
      "text" : "Kijk, daar is ie."
    },
    {
      "endTime" : "00:12:01,940",
      "speakerDesignation" : "",
      "startTime" : "00:12:01,180",
      "text" : "Daar is ie."
    },
    {
      "endTime" : "00:12:04,540",
      "speakerDesignation" : "",
      "startTime" : "00:12:02,580",
      "text" : "Ja, het is met omzicht toch zo."
    },
    {
      "endTime" : "00:12:07,800",
      "speakerDesignation" : "",
      "startTime" : "00:12:04,600",
      "text" : "Die heeft toch op de een of andere manier nog altijd..."
    },
    {
      "endTime" : "00:12:10,880",
      "speakerDesignation" : "",
      "startTime" : "00:12:07,800",
      "text" : "niet alleen bij z'n collega's, maar bij het publiek ook iets van..."
    },
    {
      "endTime" : "00:12:11,680",
      "speakerDesignation" : "",
      "startTime" : "00:12:10,880",
      "text" : "Ah, ah, ah."
    },
    {
      "endTime" : "00:12:17,960",
      "speakerDesignation" : "",
      "startTime" : "00:12:12,520",
      "text" : "Nee, maar hij is namelijk in en in tegen."
    },
    {
      "endTime" : "00:12:19,960",
      "speakerDesignation" : "",
      "startTime" : "00:12:18,600",
      "text" : "In en in tegen."
    },
    {
      "endTime" : "00:12:23,460",
      "speakerDesignation" : "",
      "startTime" : "00:12:21,880",
      "text" : "En dat is precies de pest."
    },
    {
      "endTime" : "00:12:26,000",
      "speakerDesignation" : "",
      "startTime" : "00:12:23,460",
      "text" : "Want ja, moet je kijken door wie je omringd wordt in de politiek."
    },
    {
      "endTime" : "00:12:28,480",
      "speakerDesignation" : "",
      "startTime" : "00:12:26,080",
      "text" : "Het is allemaal gaaiers en schoftentuig."
    },
    {
      "endTime" : "00:12:31,100",
      "speakerDesignation" : "",
      "startTime" : "00:12:28,860",
      "text" : "Als je het niet aankunt, hoef er op!"
    },
    {
      "endTime" : "00:12:37,380",
      "speakerDesignation" : "",
      "startTime" : "00:12:31,760",
      "text" : "Blijf alleen op Twente zitten en blijf daar een beetje de figuur die het allemaal door heeft zitten."
    },
    {
      "endTime" : "00:12:40,120",
      "speakerDesignation" : "",
      "startTime" : "00:12:37,680",
      "text" : "Maar kom alsjeblieft niet naar de Randstad!"
    },
    {
      "endTime" : "00:12:43,720",
      "speakerDesignation" : "",
      "startTime" : "00:12:41,180",
      "text" : "Nou ja, zo ging het gisteren ongeveer een half uur."
    },
    {
      "endTime" : "00:12:48,640",
      "speakerDesignation" : "",
      "startTime" : "00:12:46,740",
      "text" : "Gaat u minister-president worden?"
    },
    {
      "endTime" : "00:12:55,620",
      "speakerDesignation" : "",
      "startTime" : "00:12:53,460",
      "text" : "Weet ik nog niet."
    },
    {
      "endTime" : "00:12:59,840",
      "speakerDesignation" : "",
      "startTime" : "00:12:58,920",
      "text" : "Godver."
    },
    {
      "endTime" : "00:13:02,700",
      "speakerDesignation" : "",
      "startTime" : "00:13:02,060",
      "text" : "Godverdomme."
    },
    {
      "endTime" : "00:13:05,320",
      "speakerDesignation" : "",
      "startTime" : "00:13:03,460",
      "text" : "Maar het is echt ongelooflijk."
    },
    {
      "endTime" : "00:13:06,420",
      "speakerDesignation" : "",
      "startTime" : "00:13:05,460",
      "text" : "Dit land is gewoon..."
    },
    {
      "endTime" : "00:13:07,300",
      "speakerDesignation" : "",
      "startTime" : "00:13:06,420",
      "text" : "We hebben niks..."
    },
    {
      "endTime" : "00:13:08,900",
      "speakerDesignation" : "",
      "startTime" : "00:13:07,300",
      "text" : "We hebben geen voorjaarsnoten."
    },
    {
      "endTime" : "00:13:10,200",
      "speakerDesignation" : "",
      "startTime" : "00:13:08,980",
      "text" : "Heeft u dat bestudeerd?"
    },
    {
      "endTime" : "00:13:12,420",
      "speakerDesignation" : "",
      "startTime" : "00:13:10,760",
      "text" : "Wat daar voor ontrein is."
    },
    {
      "endTime" : "00:13:13,600",
      "speakerDesignation" : "",
      "startTime" : "00:13:12,500",
      "text" : "Allemaal te danken."
    },
    {
      "endTime" : "00:13:18,020",
      "speakerDesignation" : "",
      "startTime" : "00:13:17,020",
      "text" : "Goed, ik sta hier."
    },
    {
      "endTime" : "00:13:20,320",
      "speakerDesignation" : "",
      "startTime" : "00:13:18,860",
      "text" : "Ik heb al drie keer gevloekt."
    },
    {
      "endTime" : "00:13:22,120",
      "speakerDesignation" : "",
      "startTime" : "00:13:20,420",
      "text" : "Dan nodig de ruimte kennelijk toe uit."
    },
    {
      "endTime" : "00:13:23,200",
      "speakerDesignation" : "",
      "startTime" : "00:13:22,240",
      "text" : "Ik weet niet wat het is."
    },
    {
      "endTime" : "00:13:30,280",
      "speakerDesignation" : "",
      "startTime" : "00:13:23,460",
      "text" : "Mevrouw Faber heeft nu weer voor een gedeelte haar zin gekregen."
    },
    {
      "endTime" : "00:13:36,280",
      "speakerDesignation" : "",
      "startTime" : "00:13:30,540",
      "text" : "Want de derde wereldlanders gaan dus nu terug naar hun derde wereldland."
    },
    {
      "endTime" : "00:13:39,320",
      "speakerDesignation" : "",
      "startTime" : "00:13:37,240",
      "text" : "En ik dacht dat de derde wereld niet meer bestond."
    },
    {
      "endTime" : "00:13:41,740",
      "speakerDesignation" : "",
      "startTime" : "00:13:39,400",
      "text" : "Maar in dit geval hebben ze hem weer opnieuw in het leven."
    },
    {
      "endTime" : "00:13:49,220",
      "speakerDesignation" : "",
      "startTime" : "00:13:41,740",
      "text" : "Dat zijn dus mensen die vanuit wat deel van de wereld ook een toekomst zagen in Oekraïne."
    },
    {
      "endTime" : "00:13:54,220",
      "speakerDesignation" : "",
      "startTime" : "00:13:49,220",
      "text" : "en die toen gevlucht zijn, toen de Russen binnenvielen..."
    },
    {
      "endTime" : "00:13:56,460",
      "speakerDesignation" : "",
      "startTime" : "00:13:55,020",
      "text" : "en in Nederland zijn terechtgekomen."
    },
    {
      "endTime" : "00:14:00,200",
      "speakerDesignation" : "",
      "startTime" : "00:13:56,940",
      "text" : "En ja, daar zit je dan opeens weer met 20.000 man..."
    },
    {
      "endTime" : "00:14:03,880",
      "speakerDesignation" : "",
      "startTime" : "00:14:00,200",
      "text" : "en die mogen er nu uitsturen."
    },
    {
      "endTime" : "00:14:08,540",
      "speakerDesignation" : "",
      "startTime" : "00:14:04,700",
      "text" : "Dus mevrouw Faber zit vandaag met een krul in de staart thuis."
    },
    {
      "endTime" : "00:14:13,100",
      "speakerDesignation" : "",
      "startTime" : "00:14:09,040",
      "text" : "Want die heeft het natuurlijk niet altijd makkelijk gehad."
    },
    {
      "endTime" : "00:14:16,220",
      "speakerDesignation" : "",
      "startTime" : "00:14:13,420",
      "text" : "Maar ze is daar ter afschrikking."
    },
    {
      "endTime" : "00:14:16,740",
      "speakerDesignation" : "",
      "startTime" : "00:14:16,220",
      "text" : "Schrikking."
    },
    {
      "endTime" : "00:14:19,340",
      "speakerDesignation" : "",
      "startTime" : "00:14:17,560",
      "text" : "Zij moeten mensen..."
    },
    {
      "endTime" : "00:14:21,580",
      "speakerDesignation" : "",
      "startTime" : "00:14:19,340",
      "text" : "Want in die vluchtelingenkampen worden folders..."
    },
    {
      "endTime" : "00:14:23,480",
      "speakerDesignation" : "",
      "startTime" : "00:14:21,580",
      "text" : "door de mensen-smokkelaars folders uitgedeeld."
    },
    {
      "endTime" : "00:14:24,880",
      "speakerDesignation" : "",
      "startTime" : "00:14:23,840",
      "text" : "Waar wil je heen?"
    },
    {
      "endTime" : "00:14:27,740",
      "speakerDesignation" : "",
      "startTime" : "00:14:25,300",
      "text" : "En dan slaan ze een bladje om en dan is het Nederland."
    },
    {
      "endTime" : "00:14:28,640",
      "speakerDesignation" : "",
      "startTime" : "00:14:28,180",
      "text" : "En dan..."
    },
    {
      "endTime" : "00:14:34,560",
      "speakerDesignation" : "",
      "startTime" : "00:14:28,640",
      "text" : "Dat is de bedoeling."
    },
    {
      "endTime" : "00:14:37,140",
      "speakerDesignation" : "",
      "startTime" : "00:14:35,100",
      "text" : "Dat is het masterplan van Geert Wilders."
    },
    {
      "endTime" : "00:14:39,860",
      "speakerDesignation" : "",
      "startTime" : "00:14:38,480",
      "text" : "En nu is het zo."
    },
    {
      "endTime" : "00:14:41,520",
      "speakerDesignation" : "",
      "startTime" : "00:14:40,000",
      "text" : "Want de oorlog dreigt."
    },
    {
      "endTime" : "00:14:43,500",
      "speakerDesignation" : "",
      "startTime" : "00:14:41,520",
      "text" : "We zitten in een grijs gebied."
    },
    {
      "endTime" : "00:14:44,840",
      "speakerDesignation" : "",
      "startTime" : "00:14:43,560",
      "text" : "Is er gisteren vastgesteld."
    },
    {
      "endTime" : "00:14:49,840",
      "speakerDesignation" : "",
      "startTime" : "00:14:45,460",
      "text" : "We zitten in een grijs gebied waarvan je niet kan zeggen het is vrede."
    },
    {
      "endTime" : "00:14:51,480",
      "speakerDesignation" : "",
      "startTime" : "00:14:50,100",
      "text" : "Maar je kan ook niet zeggen het is oorlog."
    },
    {
      "endTime" : "00:14:55,240",
      "speakerDesignation" : "",
      "startTime" : "00:14:52,440",
      "text" : "En dat gaat ons 800 miljard kosten."
    },
    {
      "endTime" : "00:14:57,640",
      "speakerDesignation" : "",
      "startTime" : "00:14:55,380",
      "text" : "Maar wij willen daar eigenlijk liever niet aan meedoen."
    },
    {
      "endTime" : "00:15:00,480",
      "speakerDesignation" : "",
      "startTime" : "00:14:57,960",
      "text" : "Want is de redenatie hier van de coalitie."
    },
    {
      "endTime" : "00:15:01,840",
      "speakerDesignation" : "",
      "startTime" : "00:15:00,720",
      "text" : "Wij hebben mevrouw Faber."
    },
    {
      "endTime" : "00:15:07,180",
      "speakerDesignation" : "",
      "startTime" : "00:15:03,320",
      "text" : "Ja, mocht het zover komen, dan zetten we haar aan de grens met een paraplu."
    },
    {
      "endTime" : "00:15:10,420",
      "speakerDesignation" : "",
      "startTime" : "00:15:07,600",
      "text" : "Nou jongen, die Russen schrikken zich te pletterig."
    },
    {
      "endTime" : "00:15:12,600",
      "speakerDesignation" : "",
      "startTime" : "00:15:10,920",
      "text" : "Ze zeggen..."
    },
    {
      "endTime" : "00:15:15,540",
      "speakerDesignation" : "",
      "startTime" : "00:15:12,600",
      "text" : "Rechtsomkamer, alle drones raken in de war."
    },
    {
      "endTime" : "00:15:17,260",
      "speakerDesignation" : "",
      "startTime" : "00:15:15,800",
      "text" : "Het hele zooitje gaat niet door."
    },
    {
      "endTime" : "00:15:18,860",
      "speakerDesignation" : "",
      "startTime" : "00:15:17,780",
      "text" : "Mevrouw Faber."
    },
    {
      "endTime" : "00:15:22,120",
      "speakerDesignation" : "",
      "startTime" : "00:15:19,780",
      "text" : "Ja, het leger. Ik heb een kleindochter van 16."
    },
    {
      "endTime" : "00:15:24,480",
      "speakerDesignation" : "",
      "startTime" : "00:15:22,620",
      "text" : "16 jaar. Onvoorstelbaar."
    },
    {
      "endTime" : "00:15:26,640",
      "speakerDesignation" : "",
      "startTime" : "00:15:24,560",
      "text" : "Die kreeg een brief van de overheid..."
    },
    {
      "endTime" : "00:15:30,500",
      "speakerDesignation" : "",
      "startTime" : "00:15:26,640",
      "text" : "dat ze over twee jaar wel eens in dienst zou moeten kunnen gaan."
    },
    {
      "endTime" : "00:15:33,840",
      "speakerDesignation" : "",
      "startTime" : "00:15:31,280",
      "text" : "16 jaar. Ik krijg er nu al bericht van..."
    },
    {
      "endTime" : "00:15:35,960",
      "speakerDesignation" : "",
      "startTime" : "00:15:33,840",
      "text" : "bereid je er maar op voor dat je..."
    },
    {
      "endTime" : "00:15:38,200",
      "speakerDesignation" : "",
      "startTime" : "00:15:35,960",
      "text" : "De dienstbericht is nooit helemaal afgeschaft."
    },
    {
      "endTime" : "00:15:39,980",
      "speakerDesignation" : "",
      "startTime" : "00:15:38,200",
      "text" : "Die wordt weer in het leven geroepen."
    },
    {
      "endTime" : "00:15:44,520",
      "speakerDesignation" : "",
      "startTime" : "00:15:39,980",
      "text" : "En tussen jongens en meisjes wordt in ons land ook geen onderscheid meer gemaakt."
    },
    {
      "endTime" : "00:15:46,360",
      "speakerDesignation" : "",
      "startTime" : "00:15:44,680",
      "text" : "Dus het is niet alleen de jongens."
    },
    {
      "endTime" : "00:15:51,660",
      "speakerDesignation" : "",
      "startTime" : "00:15:46,960",
      "text" : "De meisjes zijn evenzeer de klos op dit moment."
    },
    {
      "endTime" : "00:15:55,820",
      "speakerDesignation" : "",
      "startTime" : "00:15:52,680",
      "text" : "Het gaat vanavond voor een deel over dit boek."
    },
    {
      "endTime" : "00:15:58,000",
      "speakerDesignation" : "",
      "startTime" : "00:15:56,100",
      "text" : "Dat speelt in de jaren 60."
    },
    {
      "endTime" : "00:16:00,580",
      "speakerDesignation" : "",
      "startTime" : "00:15:58,120",
      "text" : "Van 62 tot 69."
    },
    {
      "endTime" : "00:16:03,000",
      "speakerDesignation" : "",
      "startTime" : "00:16:01,320",
      "text" : "En daar ontmoet ik Bram Vermeulen."
    },
    {
      "endTime" : "00:16:05,720",
      "speakerDesignation" : "",
      "startTime" : "00:16:03,500",
      "text" : "En daar hadden wij met jongens, we zaten dan zo bij elkaar."
    },
    {
      "endTime" : "00:16:08,700",
      "speakerDesignation" : "",
      "startTime" : "00:16:05,720",
      "text" : "Dan ging het over de dienstkeuring opscheppen."
    },
    {
      "endTime" : "00:16:09,680",
      "speakerDesignation" : "",
      "startTime" : "00:16:08,840",
      "text" : "Een beetje dingen opscheppen."
    },
    {
      "endTime" : "00:16:13,680",
      "speakerDesignation" : "",
      "startTime" : "00:16:09,980",
      "text" : "Bram vertelde dat hij zou weigeren."
    },
    {
      "endTime" : "00:16:15,000",
      "speakerDesignation" : "",
      "startTime" : "00:16:13,700",
      "text" : "Hij zou geweigerd hebben."
    },
    {
      "endTime" : "00:16:17,220",
      "speakerDesignation" : "",
      "startTime" : "00:16:15,920",
      "text" : "Dat was zijn redenatie."
    },
    {
      "endTime" : "00:16:22,100",
      "speakerDesignation" : "",
      "startTime" : "00:16:17,580",
      "text" : "Waren het niet dat zijn beide oudere broers al in dienst hadden gezeten."
    },
    {
      "endTime" : "00:16:27,460",
      "speakerDesignation" : "",
      "startTime" : "00:16:23,980",
      "text" : "Dus broederdienst had je dan. Broederdienst."
    },
    {
      "endTime" : "00:16:29,740",
      "speakerDesignation" : "",
      "startTime" : "00:16:27,800",
      "text" : "Ik ben afgekeurd op mijn ogen."
    },
    {
      "endTime" : "00:16:31,380",
      "speakerDesignation" : "",
      "startTime" : "00:16:30,440",
      "text" : "Ik ben afgekeurd."
    },
    {
      "endTime" : "00:16:36,300",
      "speakerDesignation" : "",
      "startTime" : "00:16:32,000",
      "text" : "Ja, je gelooft het niet, maar ik ben afgekeurd."
    },
    {
      "endTime" : "00:16:38,480",
      "speakerDesignation" : "",
      "startTime" : "00:16:37,220",
      "text" : "Afgekeurd op mijn ogen."
    },
    {
      "endTime" : "00:16:42,720",
      "speakerDesignation" : "",
      "startTime" : "00:16:38,480",
      "text" : "Die Sjusjan die mij op mijn ogen moest keuren, zat in zo'n kamertje."
    },
    {
      "endTime" : "00:16:49,140",
      "speakerDesignation" : "",
      "startTime" : "00:16:43,280",
      "text" : "En daar hing zo'n bord van de opticien met van die grote letters aan de muur."
    },
    {
      "endTime" : "00:16:52,200",
      "speakerDesignation" : "",
      "startTime" : "00:16:49,480",
      "text" : "En hij zei tegen mij, kijk even naar dat bord."
    },
    {
      "endTime" : "00:16:53,920",
      "speakerDesignation" : "",
      "startTime" : "00:16:52,700",
      "text" : "En toen zei ik, welk bord?"
    },
    {
      "endTime" : "00:16:57,740",
      "speakerDesignation" : "",
      "startTime" : "00:16:56,500",
      "text" : "Dat was de goed begin."
    },
    {
      "endTime" : "00:17:01,580",
      "speakerDesignation" : "",
      "startTime" : "00:16:59,140",
      "text" : "En we hadden nog een vriend, Eddie Habberma."
    },
    {
      "endTime" : "00:17:02,860",
      "speakerDesignation" : "",
      "startTime" : "00:17:01,720",
      "text" : "Misschien zegt die naam u nog iets."
    },
    {
      "endTime" : "00:17:05,040",
      "speakerDesignation" : "",
      "startTime" : "00:17:02,860",
      "text" : "Hij is groot regisseur geworden van musicals."
    },
    {
      "endTime" : "00:17:08,420",
      "speakerDesignation" : "",
      "startTime" : "00:17:05,080",
      "text" : "Heeft nog op Broadway gestaan met Cyrano de Bergerac."
    },
    {
      "endTime" : "00:17:13,140",
      "speakerDesignation" : "",
      "startTime" : "00:17:08,480",
      "text" : "En bij de keuring heeft hij homoseksualiteit voorgewend."
    },
    {
      "endTime" : "00:17:16,900",
      "speakerDesignation" : "",
      "startTime" : "00:17:15,200",
      "text" : "Ja, nee, dat was echt zo."
    },
    {
      "endTime" : "00:17:18,900",
      "speakerDesignation" : "",
      "startTime" : "00:17:17,000",
      "text" : "En toen heeft hij S5 gekregen."
    },
    {
      "endTime" : "00:17:22,060",
      "speakerDesignation" : "",
      "startTime" : "00:17:19,040",
      "text" : "Dat was toen ook heel erg begeerlijk."
    },
    {
      "endTime" : "00:17:24,200",
      "speakerDesignation" : "",
      "startTime" : "00:17:22,380",
      "text" : "Ik had geen S5, ik had plus 10."
    },
    {
      "endTime" : "00:17:29,760",
      "speakerDesignation" : "",
      "startTime" : "00:17:26,520",
      "text" : "En nu hebben wij een zangeres in Nederland en die heet..."
    },
    {
      "endTime" : "00:17:31,080",
      "speakerDesignation" : "",
      "startTime" : "00:17:29,760",
      "text" : "S10, ja precies."
    },
    {
      "endTime" : "00:17:33,620",
      "speakerDesignation" : "",
      "startTime" : "00:17:31,960",
      "text" : "Dus die komt niet in dienst, denk ik."
    },
    {
      "endTime" : "00:17:34,620",
      "speakerDesignation" : "",
      "startTime" : "00:17:33,620",
      "text" : "Dat is..."
    },
    {
      "endTime" : "00:17:39,220",
      "speakerDesignation" : "",
      "startTime" : "00:17:34,620",
      "text" : "Een dubbele reden om haar af te keuren, denk ik."
    },
    {
      "endTime" : "00:17:47,960",
      "speakerDesignation" : "",
      "startTime" : "00:17:41,220",
      "text" : "Dames en heren, zijn er tot zover vragen?"
    }
  ]
}
